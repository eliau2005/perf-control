import sys

import cairo
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HELPER = "/usr/local/libexec/perfctl-helper"
PROFILE = "/sys/firmware/acpi/platform_profile"
CPU = "/sys/devices/system/cpu"
STATE = "/run/perfctl/state.json"
MMIO = "/sys/class/powercap/intel-rapl-mmio:0"
AC = "/sys/class/power_supply/AC0/online"
BAT = "/sys/class/power_supply/BAT0"
THRESHOLD = f"{BAT}/charge_control_end_threshold"
BAT_STATE = "/var/lib/perfctl/battery.json"
SETTINGS = os.path.join(GLib.get_user_config_dir(), "perf-control", "settings.json")
PPD = ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles")
PPD_MAP = {"quiet": "power-saver", "balanced": "balanced", "performance": "performance"}

FREQ_MAX = 4.7  # GHz, i7-1260P max turbo
TEMP_MIN, TEMP_MAX = 30, 100
HISTORY = 120  # seconds

# (sysfs name, label, icon, one-line summary)
