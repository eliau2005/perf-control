    "balanced": "Standard: PL1 38–45 W while the skin sensor is under 63 °C, then 28–38 W · "
                "PL2 45 W · throttles at 92 °C.",
    "performance": "Performance: PL1 35–38 W · PL2 45 W · throttles at 95 °C.",
}
CHARGE_LIMITS = [("60", "60 %"), ("80", "80 %"), ("100", "100 %")]
CHARGE_INFO = {
    "60": "Maximum lifespan · stops at 60 %",
