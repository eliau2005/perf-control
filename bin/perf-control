#!/usr/bin/env python3
"""Performance Control: ASUS performance mode, fan, battery charge limit and
live monitoring.

Power limits are owned by thermald running ASUS's own Intel DTT policy; the
mode selector only switches the firmware profile (Whisper/Standard/Performance),
which the EC uses for its fan table and DTT uses to pick PL1/PL2/TCC targets."""
import collections
import glob
import json
import math
import os
