def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def read_num(path):
    v = read(path)
    return int(v) if v.lstrip("-").isdigit() else None


def hwmon(name):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(f"{h}/name") == name:
            return h
    return None


def cpu_name():
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            m = re.search(r"(i[3579]-\w+)", line)
            return f"Core {m.group(1)}" if m else line.split(":", 1)[1].strip()
    return ""


def animations_enabled():
    return Gtk.Settings.get_default().props.gtk_enable_animations


def fmt_duration(hours):
    mins = int(round(hours * 60))
    return f"{mins // 60} h {mins % 60:02d} min" if mins >= 60 else f"{mins} min"


def tween(widget, duration, callback, easing=Adw.Easing.EASE_OUT_CUBIC):
    anim = Adw.TimedAnimation.new(widget, 0, 1, duration,
                                  Adw.CallbackAnimationTarget.new(callback))
    anim.set_easing(easing)
    return anim


def rounded_rect(cr, x, y, w, h, r):
    r = min(r, h / 2, w / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Sparkline(Gtk.DrawingArea):
    """Right-aligned filled line of the last HISTORY samples that scrolls
    smoothly between one-second samples."""

    def __init__(self, color, lo, hi):
        super().__init__(content_height=52, hexpand=True)
        self.color, self.lo, self.hi = color, lo, hi
        self.data = collections.deque(maxlen=HISTORY)
        self.shift = 1.0
        self.anim = tween(self, 1000, self.on_shift, Adw.Easing.LINEAR)
        self.set_draw_func(self.draw)

    def on_shift(self, v):
        self.shift = v
        self.queue_draw()

    def push(self, v):
        self.data.append(v)
        self.anim.reset()
        self.anim.play()

    def draw(self, _a, cr, w, h):
        right = w - 4  # room for the end dot
        step = right / (HISTORY - 2)
        n = len(self.data)
        offset = step * (1 - self.shift)
        top, bottom = 5, h - 2
        pts = []
        for i, v in enumerate(self.data):
            if v is None:
                continue
            f = max(0.0, min(1.0, (v - self.lo) / (self.hi - self.lo)))
            pts.append((right - step * (n - 1 - i) + offset, bottom - (bottom - top) * f))
        if len(pts) < 2:
            return
        cr.move_to(*pts[0])
        for p in pts[1:]:
            cr.line_to(*p)
        path = cr.copy_path()
        cr.line_to(pts[-1][0], h)
        cr.line_to(pts[0][0], h)
        cr.close_path()
        grad = cairo.LinearGradient(0, top, 0, h)
        grad.add_color_stop_rgba(0, *self.color, 0.32)
        grad.add_color_stop_rgba(1, *self.color, 0.0)
        cr.set_source(grad)
        cr.fill()
        cr.append_path(path)
        cr.set_source_rgb(*self.color)
        cr.set_line_width(2)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.stroke()
        x, y = pts[-1]
        cr.set_source_rgba(*self.color, 0.25)
        cr.arc(x, y, 6, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*self.color)
        cr.arc(x, y, 3, 0, 2 * math.pi)
        cr.fill()


class FanIcon(Gtk.DrawingArea):
    """Three-blade fan that spins in proportion to the measured RPM."""

    def __init__(self, color):
        super().__init__(content_width=16, content_height=16, valign=Gtk.Align.CENTER)
        self.color, self.rpm, self.angle, self.last = color, 0, 0.0, None
        self.set_draw_func(self.draw)
        if animations_enabled():
            self.add_tick_callback(self.tick)

    def tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        if self.last is not None and self.rpm:
            self.angle += (t - self.last) * 2 * math.pi * self.rpm / 1500
            self.queue_draw()
        self.last = t
        return True

    def draw(self, _a, cr, w, h):
        cx, cy, r = w / 2, h / 2, min(w, h) / 2
        cr.set_source_rgb(*self.color)
        for k in range(3):
            cr.save()
            cr.translate(cx, cy)
            cr.rotate(self.angle + k * 2 * math.pi / 3)
            cr.translate(r * 0.45, 0)
            cr.scale(r * 0.5, r * 0.26)
            cr.arc(0, 0, 1, 0, 2 * math.pi)
            cr.restore()
            cr.fill()
        cr.arc(cx, cy, r * 0.2, 0, 2 * math.pi)
        cr.fill()


class Tile(Gtk.Box):
    """Stat card: label + note, big animated value + unit, sparkline."""

    def __init__(self, label, unit, color, lo, hi, fmt="{:.0f}", icon=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                         css_classes=["card", "tile"], hexpand=True)
        self.fmt, self.shown = fmt, None
        head = Gtk.Box(spacing=6)
        if icon:
            head.append(icon)
        head.append(Gtk.Label(label=label, xalign=0, hexpand=True, css_classes=["tile-label"]))
        self.note = Gtk.Label(xalign=1, css_classes=["tile-note"])
        head.append(self.note)
        self.append(head)
        row = Gtk.Box(spacing=4)
        self.value = Gtk.Label(label="–", css_classes=["tile-value"], valign=Gtk.Align.BASELINE)
        row.append(self.value)
        row.append(Gtk.Label(label=unit, css_classes=["tile-unit"], valign=Gtk.Align.BASELINE))
        self.append(row)
        self.spark = Sparkline(color, lo, hi)
        self.append(self.spark)
        self.src = self.dst = 0.0
        self.anim = tween(self, 700, self.on_tween)

    def on_tween(self, p):
        self.shown = self.src + (self.dst - self.src) * p
        self.value.set_label(self.fmt.format(self.shown))

    def set(self, v, note=None, level=None):
        if v is None:
            self.shown = None
            self.value.set_label("–")
        elif self.shown is None:
            self.shown = v
            self.value.set_label(self.fmt.format(v))
        else:
            self.src, self.dst = self.shown, v
            self.anim.reset()
            self.anim.play()
        self.value.set_css_classes(["tile-value"] + ([level] if level else []))
        if note is not None:
            self.note.set_label(note)
        self.spark.push(v)


class BatteryBar(Gtk.DrawingArea):
    """Charge level with a marker at the limit and a sweep while charging."""

    def __init__(self):
        super().__init__(content_height=16, hexpand=True)
        self.level, self.shown, self.limit, self.charging = 0, None, 100, False
        self.sweep, self.last = 0.0, None
        self.src = self.dst = 0.0
        self.anim = tween(self, 900, self.on_tween)
        self.set_draw_func(self.draw)
        if animations_enabled():
            self.add_tick_callback(self.tick)

    def on_tween(self, p):
        self.shown = self.src + (self.dst - self.src) * p
        self.queue_draw()

    def tick(self, _w, clock):
        t = clock.get_frame_time() / 1e6
        if self.charging and self.last is not None:
            self.sweep = (self.sweep + (t - self.last) / 1.8) % 1.0
            self.queue_draw()
        self.last = t
        return True

    def update(self, level, limit, charging):
        if self.shown is None:
            self.shown = level
        elif level != self.level:
            self.src, self.dst = self.shown, level
            self.anim.reset()
            self.anim.play()
        self.level, self.limit = level, limit
        if charging != self.charging:
            self.charging = charging
            self.sweep = 0.0
        self.queue_draw()

    def draw(self, _a, cr, w, h):
        c = self.get_color()
        fgc = (c.red, c.green, c.blue)
        bar_h, y = 10, (h - 10) / 2
        rounded_rect(cr, 0, y, w, bar_h, bar_h / 2)
        cr.set_source_rgba(*fgc, 0.10)
        cr.fill()
        level = self.shown or 0
        fw = max(bar_h, w * level / 100)
        color = LOW_COLOR if level < 20 else POWER_COLOR
        rounded_rect(cr, 0, y, fw, bar_h, bar_h / 2)
        cr.set_source_rgb(*color)
        cr.fill_preserve()
        if self.charging:
            sx = -w * 0.3 + (fw + w * 0.6) * self.sweep
            grad = cairo.LinearGradient(sx - w * 0.15, 0, sx + w * 0.15, 0)
            grad.add_color_stop_rgba(0, 1, 1, 1, 0)
            grad.add_color_stop_rgba(0.5, 1, 1, 1, 0.45)
            grad.add_color_stop_rgba(1, 1, 1, 1, 0)
            cr.set_source(grad)
            cr.fill()
        else:
            cr.new_path()
        if self.limit < 100:
            x = w * self.limit / 100
            cr.set_source_rgba(*fgc, 0.75)
            cr.set_line_width(2)
            cr.move_to(x, 0)
            cr.line_to(x, h)
            cr.stroke()


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Performance Control")
        self.set_default_size(1080, -1)
        self.syncing = False
        self.asus = hwmon("asus")
        self.coretemp = hwmon("coretemp")
        self.fan_max = 6500
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.has_battery = bool(read(THRESHOLD))

        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Performance Control", subtitle=cpu_name()))
        header.pack_end(self.build_settings())
        view.add_top_bar(header)

        cols = Gtk.Box(spacing=28, margin_top=18, margin_bottom=22, margin_start=24, margin_end=24)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22, hexpand=True)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22, width_request=400)
        cols.append(left)
        cols.append(right)
        for box, sections in ((left, (self.build_mode(), self.build_live(), self.build_cooling())),
                              (right, ((self.build_battery(),) if self.has_battery else ())
                               + (self.build_details(),))):
            for i, w in enumerate(sections):
                w.add_css_class("rise")
                w.add_css_class(f"d{i + (2 if box is right else 0)}")
                box.append(w)

        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                    propagate_natural_height=True, child=cols)
        view.set_content(scroll)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        self.sync_controls()
        self.refresh()
        GLib.timeout_add_seconds(1, self.refresh)

    # -- layout --------------------------------------------------------------
    def build_settings(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["settings-pop"])
        box.append(Gtk.Label(label="Appearance", xalign=0, css_classes=["heading"]))
        self.theme = Adw.ToggleGroup()
        for name, label, icon in (("system", "System", "emblem-system-symbolic"),
                                  ("light", "Light", "weather-clear-symbolic"),
                                  ("dark", "Dark", "weather-clear-night-symbolic")):
            self.theme.add(Adw.Toggle(name=name, label=label, icon_name=icon))
        self.theme.set_active_name(self.get_application().theme)
        self.theme.connect("notify::active-name",
                           lambda t, _p: self.get_application().set_theme(t.get_active_name()))
        box.append(self.theme)
        return Gtk.MenuButton(icon_name="open-menu-symbolic", tooltip_text="Settings",
                              popover=Gtk.Popover(child=box))

    def build_mode(self):
        group = Adw.PreferencesGroup(title="Mode")
        box = Gtk.Box(spacing=10, homogeneous=True)
        self.mode_buttons = {}
        first = None
        for name, label, icon, sub in MODES:
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            content.append(Gtk.Image(icon_name=icon, pixel_size=28, margin_bottom=6))
            content.append(Gtk.Label(label=label, css_classes=["mode-name"]))
            content.append(Gtk.Label(label=sub, css_classes=["mode-sub"]))
            btn = Gtk.ToggleButton(child=content, css_classes=["mode-card"], group=first)
            btn.connect("toggled", self.on_mode_toggled, name)
            first = first or btn
            self.mode_buttons[name] = btn
            box.append(btn)
        group.add(box)
        return group

    def build_live(self):
        group = Adw.PreferencesGroup(title="Live")
        group.set_header_suffix(Gtk.Label(label=f"last {HISTORY // 60} min",
                                          css_classes=["dim-label", "caption"]))
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        self.fan_icon = FanIcon(FAN_COLOR)
        self.t_temp = Tile("CPU temperature", "°C", TEMP_COLOR, TEMP_MIN, TEMP_MAX)
        self.t_power = Tile("Package power", "W", POWER_COLOR, 0, 45, "{:.1f}")
        self.t_freq = Tile("CPU clock", "GHz", FREQ_COLOR, 0, FREQ_MAX, "{:.1f}")
        self.t_fan = Tile("Fan", "RPM", FAN_COLOR, 0, self.fan_max, icon=self.fan_icon)
        grid.attach(self.t_temp, 0, 0, 1, 1)
        grid.attach(self.t_power, 1, 0, 1, 1)
        grid.attach(self.t_freq, 0, 1, 1, 1)
        grid.attach(self.t_fan, 1, 1, 1, 1)
        group.add(grid)
        return group

    def build_cooling(self):
        group = Adw.PreferencesGroup(title="Cooling")
        self.fan_row = Adw.ActionRow(title="Fan")
        self.fan = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        for name, label in (("auto", "Auto"), ("full", "Full speed")):
            self.fan.add(Adw.Toggle(name=name, label=label))
        self.fan.connect("notify::active-name",
                         lambda t, _p: None if self.syncing else self.run("fan", t.get_active_name()))
        self.fan_row.add_suffix(self.fan)
        group.add(self.fan_row)
        return group

    def build_battery(self):
        group = Adw.PreferencesGroup(title="Battery")
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                       css_classes=["card", "battery-card"])
        top = Gtk.Box(spacing=8)
        self.bat_pct = Gtk.Label(css_classes=["tile-value"], valign=Gtk.Align.BASELINE)
        top.append(self.bat_pct)
        self.bat_state = Gtk.Label(css_classes=["dim-label"], valign=Gtk.Align.BASELINE,
                                   xalign=0, hexpand=True)
        top.append(self.bat_state)
        self.bat_icon = Gtk.Image(pixel_size=20, valign=Gtk.Align.CENTER)
        top.append(self.bat_icon)
        card.append(top)
        self.bat_bar = BatteryBar()
        card.append(self.bat_bar)
        self.bat_eta = Gtk.Label(xalign=0, css_classes=["caption", "dim-label"])
        card.append(self.bat_eta)
        outer.append(card)

        rows = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE)
        self.limit_row = Adw.ActionRow(title="Charge limit")
        self.limit = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        for name, label in CHARGE_LIMITS:
            self.limit.add(Adw.Toggle(name=name, label=label))
        self.limit.connect("notify::active-name",
                           lambda t, _p: None if self.syncing or not t.get_active_name()
                           else self.run("battery", "limit", t.get_active_name()))
        self.limit_row.add_suffix(self.limit)
        rows.append(self.limit_row)
        self.once_row = Adw.ActionRow(title="One-time full charge", subtitle_lines=2)
        self.once_btn = Gtk.Button(valign=Gtk.Align.CENTER)
        self.once_btn.connect("clicked", self.toggle_full_once)
        self.once_row.add_suffix(self.once_btn)
        rows.append(self.once_row)
        outer.append(rows)
        group.add(outer)
        return group

    def build_details(self):
        self.details = Adw.PreferencesGroup(title="Power policy")
        card = Gtk.Box(css_classes=["card", "detail-card"])
        grid = Gtk.Grid(row_spacing=7, column_spacing=16, hexpand=True)
        self.detail_vals = {}
        for i, (key, title) in enumerate((("engine", "Policy engine"), ("target", "DTT target"),
                                          ("range", "Target range"), ("limits", "Applied limits"),
                                          ("tcc", "Thermal limit"), ("sensors", "Skin sensors"),
                                          ("trips", "Thermal trips"), ("cpu", "Turbo · governor"))):
            grid.attach(Gtk.Label(label=title, xalign=0, css_classes=["key"]), 0, i, 1, 1)
            val = Gtk.Label(xalign=1, hexpand=True, css_classes=["value"],
                            ellipsize=3)  # Pango.EllipsizeMode.END
            grid.attach(val, 1, i, 1, 1)
            self.detail_vals[key] = val
        card.append(grid)
        self.details.add(card)
        return self.details

    # -- helpers -------------------------------------------------------------
    def detail(self, key, text, cls=None):
        lbl = self.detail_vals[key]
        lbl.set_label(text)
        lbl.set_css_classes(["value"] + ([cls] if cls else []))

    def name_has_owner(self, name):
        try:
            r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "NameHasOwner",
                                   GLib.Variant("(s)", (name,)), None, 0, 200, None)
            return r.unpack()[0]
        except GLib.Error:
            return False

    def on_mode_toggled(self, btn, mode):
        if btn.get_active() and not self.syncing:
            self.set_mode(mode)

    def set_mode(self, mode):
        """Prefer power-profiles-daemon so GNOME's power mode stays in sync."""
        if self.name_has_owner(PPD[0]):
            try:
                self.bus.call_sync(PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Set",
                                   GLib.Variant("(ssv)", (PPD[0], "ActiveProfile",
                                                          GLib.Variant("s", PPD_MAP[mode]))),
                                   None, 0, 2000, None)
                GLib.timeout_add(500, lambda: (self.sync_controls(), False)[1])
                return
            except GLib.Error as e:
                self.toasts.add_toast(Adw.Toast(title=f"power-profiles-daemon: {e.message}"))
        self.run("profile", mode)

    def run(self, *args):
        proc = Gio.Subprocess.new(
            ["pkexec", HELPER, *args],
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)

        def done(p, res):
            _ok, out, _ = p.communicate_utf8_finish(res)
            if p.get_exit_status() != 0:
                msg = (out or "").strip().splitlines()
                self.toasts.add_toast(Adw.Toast(
                    title=f"Couldn't change {args[0]}: {msg[-1] if msg else 'not authorized'}"))
            self.sync_controls()
            self.refresh()

        proc.communicate_utf8_async(None, None, done)

    def battery_state(self):
        """(limit, full_once). The saved limit wins while a full charge is pending."""
        st = read_json(BAT_STATE, {})
        full_once = bool(st.get("full_once"))
        limit = str(st["limit"]) if "limit" in st else read(THRESHOLD)
        return limit, full_once

    def toggle_full_once(self, _btn):
        _limit, full_once = self.battery_state()
        self.run("battery", "cancel" if full_once else "full-once")

    def sync_controls(self):
        self.syncing = True
        mode = read(PROFILE, "balanced")
        if mode in self.mode_buttons:
            self.mode_buttons[mode].set_active(True)
        self.details.set_description(MODE_INFO.get(mode, ""))
        full = self.asus and read(f"{self.asus}/pwm1_enable") == "0"
        self.fan.set_active_name("full" if full else "auto")
        self.fan_row.set_subtitle("Locked at full speed" if full else "Firmware fan curve for the mode")
        if self.has_battery:
            limit, full_once = self.battery_state()
            self.limit.set_active_name(limit)
            self.limit_row.set_subtitle(CHARGE_INFO.get(limit, f"Stops at {limit} %"))
            on_ac = read(AC) == "1"
            if full_once:
                self.once_row.set_subtitle(f"Charging to 100 % · back to {limit} % when full or unplugged")
                self.once_btn.set_label("Cancel")
                self.once_btn.set_css_classes(["pill"])
                self.once_btn.set_sensitive(True)
            else:
                self.once_row.set_subtitle("Charge to 100 % this time, then return to the limit"
                                           if on_ac else "Plug in the charger to use this")
                self.once_btn.set_label("Charge to 100 %")
                self.once_btn.set_css_classes(["pill", "suggested-action"])
                self.once_btn.set_sensitive(on_ac and limit != "100")
        self.syncing = False

    def refresh_battery(self, on_ac):
        cap = read_num(f"{BAT}/capacity") or 0
        status = read(f"{BAT}/status")
        charging = status == "Charging"
        limit, full_once = self.battery_state()
        target = 100 if full_once else int(limit) if limit.isdigit() else 100
        self.bat_pct.set_label(f"{cap} %")
        self.bat_state.set_label("Charging" if charging else "Plugged in" if on_ac else "On battery")
        level = min(100, cap // 10 * 10)
        self.bat_icon.set_from_icon_name(
            f"battery-level-{level}{'-charging' if charging else ''}-symbolic")
        self.bat_icon.set_css_classes(["charging-icon"] if charging else [])
        self.bat_bar.update(cap, target, charging)

        now, full, power = (read_num(f"{BAT}/energy_now"), read_num(f"{BAT}/energy_full"),
                            read_num(f"{BAT}/power_now"))
        eta = ""
        if now and full and power and power > 500000:
            if charging:
                eta = f"About {fmt_duration(max(0, full * target / 100 - now) / power)} to {target} %"
            elif not on_ac:
                eta = f"About {fmt_duration(now / power)} left · {power / 1e6:.1f} W"
        if not eta:
            eta = (f"Held at the {target} % limit" if on_ac and cap >= target - 1
                   else f"Limit {target} %")
        self.bat_eta.set_label(eta)

    def refresh(self):
        temp = int(read(f"{self.coretemp}/temp1_input", "0")) / 1000 if self.coretemp else None
        rpm = int(read(f"{self.asus}/fan1_input", "0")) if self.asus else None
        if rpm and rpm > self.fan_max:
            self.fan_max = int(math.ceil(rpm * 1.15 / 500) * 500)
            self.t_fan.spark.hi = self.fan_max
        self.fan_icon.rpm = rpm or 0
        freqs = [int(read(p, "0")) / 1e6
                 for p in glob.glob(f"{CPU}/cpu[0-9]*/cpufreq/scaling_cur_freq")]
        freq = max(freqs) if freqs else None
        state = read_json(STATE, {})
        watts = state.get("power")
        pl1 = int(read(f"{MMIO}/constraint_0_power_limit_uw", "0")) // 1000000
        pl2 = int(read(f"{MMIO}/constraint_1_power_limit_uw", "0")) // 1000000
        tcc = state.get("tcc")
        throttled = bool(state.get("throttled"))

        trip = 100 - tcc if tcc is not None else None
        level = None
        if temp is not None and trip is not None:
            level = "crit" if temp >= trip - 1 else "hot" if temp >= trip - 8 else None
        self.t_temp.set(temp, "Throttling" if throttled else (f"limit {trip} °C" if trip else ""),
                        level)
        self.t_temp.note.set_css_classes(["tile-note"] + (["warn"] if throttled else []))
        self.t_power.spark.hi = max(pl2, 1)
        self.t_power.set(watts, f"PL1 {pl1} W · PL2 {pl2} W" if pl2 else "")
        self.t_freq.set(freq, f"max {FREQ_MAX} GHz")
        full = self.asus and read(f"{self.asus}/pwm1_enable") == "0"
        self.t_fan.set(rpm, "full speed" if full else "auto")

        if self.has_battery:
            self.refresh_battery(read(AC) == "1")

        thermald = self.name_has_owner("org.freedesktop.thermald")
        tgt, pol = state.get("target"), state.get("policy", {})
        skin, sen2 = state.get("skin"), state.get("sen2")
        self.detail("engine", "thermald · ASUS DTT" if thermald else "Firmware defaults",
                    "good" if thermald else "bad")
        self.detail("target", tgt.replace("_", " ") if tgt else "State daemon not running",
                    None if tgt else "bad")
        self.detail("range", f"PL1 {pol.get('pl1_min')}–{pol.get('pl1_max')} W · PL2 {pol.get('pl2')} W"
                    if tgt else "–")
        self.detail("limits", f"PL1 {pl1} W · PL2 {pl2} W")
        self.detail("tcc", f"{trip} °C (TCC −{tcc})" if tcc is not None else "–")
        self.detail("sensors", "SEN1 " + (f"{skin:.0f}" if skin is not None else "–")
                    + " · SEN2 " + (f"{sen2:.0f}" if sen2 is not None else "–") + " °C")
        cnt = state.get("throttle_count")
        self.detail("trips", f"{cnt:,}" if cnt is not None else "–")
        turbo = "Turbo on" if read(f"{CPU}/intel_pstate/no_turbo") != "1" else "Turbo off"
        gov = read(f"{CPU}/cpufreq/policy0/scaling_governor").capitalize()
        epp = read(f"{CPU}/cpufreq/policy0/energy_performance_preference").replace("_", " ")
        self.detail("cpu", f"{turbo} · {gov} · {epp}")
        if not self.syncing:
            self.sync_controls()
        return True


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="local.PerfControl")
        self.theme = read_json(SETTINGS, {}).get("theme", "system")
        if self.theme not in THEMES:
            self.theme = "system"

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(THEMES[self.theme])

    def set_theme(self, name):
        if name not in THEMES:
            return
        self.theme = name
        Adw.StyleManager.get_default().set_color_scheme(THEMES[name])
        try:
            os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
            with open(SETTINGS, "w") as f:
                json.dump({"theme": name}, f)
        except OSError:
            pass

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()
        # no keyboard focus ring on the first mode card at startup
        GLib.idle_add(lambda: win.set_focus_visible(False))


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
