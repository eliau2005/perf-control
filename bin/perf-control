#!/usr/bin/env python3
"""Performance Control: ASUS performance mode, fan boost and live monitoring.

Power limits are owned by thermald running ASUS's own Intel DTT policy; the
mode selector only switches the firmware profile (Whisper/Standard/Performance),
which the EC uses for its fan table and DTT uses to pick PL1/PL2/TCC targets."""
import collections
import glob
import json
import math
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HELPER = "/usr/local/libexec/perfctl-helper"
PROFILE = "/sys/firmware/acpi/platform_profile"
CPU = "/sys/devices/system/cpu"
STATE = "/run/perfctl/state.json"
MMIO = "/sys/class/powercap/intel-rapl-mmio:0"
PPD = ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles")
PPD_MAP = {"quiet": "power-saver", "balanced": "balanced", "performance": "performance"}

FREQ_MAX = 4.7  # GHz, i7-1260P max turbo
TEMP_MIN, TEMP_MAX = 30, 100
HISTORY = 120  # seconds
MODES = [("quiet", "Whisper"), ("balanced", "Standard"), ("performance", "Performance")]
MODE_INFO = {
    "quiet": "PL1 15–20 W · PL2 45 W · throttles at 89 °C",
    "balanced": "PL1 38–45 W while the skin sensor is under 63 °C, then 28–38 W · PL2 45 W · throttles at 92 °C",
    "performance": "PL1 35–38 W · PL2 45 W · throttles at 95 °C",
}

TEMP_COLOR = (0.90, 0.38, 0.0)
FAN_COLOR = (0.21, 0.52, 0.89)
FREQ_COLOR = (0.57, 0.25, 0.67)
CSS = """
.gauge-card { padding: 12px 6px 6px 6px; }
.chip { padding: 4px 12px; border-radius: 999px; background: alpha(currentColor, 0.08); font-size: 0.9em; }
.chip.on { background: alpha(@accent_bg_color, 0.25); }
.chip.warn { background: alpha(@error_bg_color, 0.35); }
"""


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def hwmon(name):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(f"{h}/name") == name:
            return h
    return None


def fg(widget):
    c = widget.get_color()
    return c.red, c.green, c.blue


def heat(frac):
    """Green -> amber -> red for 0..1."""
    frac = max(0.0, min(1.0, frac))
    if frac < 0.5:
        return (0.20 + 1.4 * frac * 0.55, 0.66, 0.33 - frac * 0.4)
    return (0.97, 0.66 - (frac - 0.5) * 1.1, 0.13)


class Gauge(Gtk.DrawingArea):
    def __init__(self, title, unit, lo, hi, color=None, fmt="{:.0f}"):
        super().__init__(content_width=110, content_height=130, hexpand=True)
        self.title, self.unit, self.lo, self.hi = title, unit, lo, hi
        self.color, self.fmt, self.value = color, fmt, None
        self.set_draw_func(self.draw)

    def set_value(self, v, hi=None):
        self.value = v
        if hi:
            self.hi = hi
        self.queue_draw()

    def draw(self, _a, cr, w, h):
        r_fg = fg(self)
        cx, cy = w / 2, h * 0.52
        r = min(w, h * 1.15) * 0.40
        start, sweep = math.radians(135), math.radians(270)
        cr.set_line_width(r * 0.16)
        cr.set_line_cap(1)  # round
        cr.set_source_rgba(*r_fg, 0.12)
        cr.arc(cx, cy, r, start, start + sweep)
        cr.stroke()
        if self.value is not None:
            frac = max(0.0, min(1.0, (self.value - self.lo) / (self.hi - self.lo)))
            cr.set_source_rgb(*(self.color or heat(frac)))
            cr.arc(cx, cy, r, start, start + max(sweep * frac, 0.01))
            cr.stroke()
            text = self.fmt.format(self.value)
        else:
            text = "–"
        cr.set_source_rgb(*r_fg)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(r * 0.52)
        ext = cr.text_extents(text)
        cr.move_to(cx - ext.width / 2 - ext.x_bearing, cy + ext.height / 2 - r * 0.08)
        cr.show_text(text)
        cr.select_font_face("Sans", 0, 0)
        cr.set_font_size(r * 0.22)
        cr.set_source_rgba(*r_fg, 0.6)
        ext = cr.text_extents(self.unit)
        cr.move_to(cx - ext.width / 2, cy + r * 0.45)
        cr.show_text(self.unit)
        cr.set_font_size(max(11, r * 0.24))
        cr.set_source_rgba(*r_fg, 0.85)
        ext = cr.text_extents(self.title)
        cr.move_to(cx - ext.width / 2, h - 4)
        cr.show_text(self.title)


class History(Gtk.DrawingArea):
    def __init__(self):
        super().__init__(content_height=150, hexpand=True)
        self.data = collections.deque(maxlen=HISTORY)
        self.fan_max = 6500
        self.watt_max = 50
        self.set_draw_func(self.draw)

    def push(self, temp, fan, freq, watts):
        self.data.append((temp, fan, freq, watts))
        self.queue_draw()

    def draw(self, _a, cr, w, h):
        c = fg(self)
        left, right, top, bottom = 8, 8, 22, 8
        pw, ph = w - left - right, h - top - bottom
        cr.set_line_width(1)
        cr.set_source_rgba(*c, 0.10)
        for i in range(5):
            y = top + ph * i / 4
            cr.move_to(left, y)
            cr.line_to(left + pw, y)
        cr.stroke()

        series = [
            (0, TEMP_COLOR, TEMP_MIN, TEMP_MAX, "Temp"),
            (1, FAN_COLOR, 0, self.fan_max, "Fan"),
            (2, FREQ_COLOR, 0, FREQ_MAX, "Clock"),
            (3, (0.2, 0.6, 0.4), 0, self.watt_max, "Power"),
        ]
        x = left
        cr.set_font_size(11)
        for _i, col, _lo, _hi, name in series:
            cr.set_source_rgb(*col)
            cr.rectangle(x, 6, 10, 10)
            cr.fill()
            cr.set_source_rgba(*c, 0.8)
            cr.move_to(x + 14, 15)
            cr.show_text(name)
            x += 14 + cr.text_extents(name).x_advance + 16
        cr.set_source_rgba(*c, 0.5)
        label = f"last {HISTORY // 60} min"
        cr.move_to(w - right - cr.text_extents(label).x_advance, 15)
        cr.show_text(label)

        n = len(self.data)
        if n < 2:
            return
        step = pw / (HISTORY - 1)
        x0 = left + pw - step * (n - 1)
        for idx, col, lo, hi, _name in series:
            pts = []
            for i, row in enumerate(self.data):
                v = row[idx]
                if v is None:
                    continue
                f = max(0.0, min(1.0, (v - lo) / (hi - lo)))
                pts.append((x0 + i * step, top + ph * (1 - f)))
            if len(pts) < 2:
                continue
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.set_source_rgb(*col)
            cr.set_line_width(2)
            cr.stroke_preserve()
            cr.line_to(pts[-1][0], top + ph)
            cr.line_to(pts[0][0], top + ph)
            cr.close_path()
            cr.set_source_rgba(*col, 0.10)
            cr.fill()


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Performance Control")
        self.set_default_size(560, 760)
        self.syncing = False
        self.asus = hwmon("asus")
        self.coretemp = hwmon("coretemp")
        self.fan_max = 6500
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        view.set_content(page)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        # Gauges
        top = Adw.PreferencesGroup()
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                       css_classes=["card", "gauge-card"])
        gauges = Gtk.Box(homogeneous=True)
        self.g_temp = Gauge("CPU temp", "°C", TEMP_MIN, TEMP_MAX)
        self.g_fan = Gauge("Fan", "RPM", 0, self.fan_max, FAN_COLOR)
        self.g_freq = Gauge("CPU clock", "GHz", 0, FREQ_MAX, FREQ_COLOR, "{:.1f}")
        self.g_watts = Gauge("CPU power", "W", 0, 45, None, "{:.1f}")
        for g in (self.g_temp, self.g_fan, self.g_freq, self.g_watts):
            gauges.append(g)
        card.append(gauges)
        self.chips = {}
        for row_names in (("power", "turbo", "gov"), ("limits", "target"), ("engine", "throttle")):
            box = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER, margin_bottom=6)
            for n in row_names:
                self.chips[n] = Gtk.Label(css_classes=["chip"])
                box.append(self.chips[n])
            card.append(box)
        self.chips["throttle"].set_label("Thermal throttling")
        self.chips["throttle"].set_css_classes(["chip", "warn"])
        top.add(card)
        page.add(top)

        # History
        hist = Adw.PreferencesGroup(title="Live")
        hcard = Gtk.Box(css_classes=["card"], margin_top=2)
        self.history = History()
        for side in ("start", "end", "top", "bottom"):
            getattr(self.history, f"set_margin_{side}")(6)
        hcard.append(self.history)
        hist.add(hcard)
        page.add(hist)

        # Controls
        ctl = Adw.PreferencesGroup(
            title="Mode",
            description="Same modes as MyASUS: the firmware picks the fan table and Intel DTT "
                        "(via thermald) applies ASUS's power-limit policy for the mode.")
        self.mode_row = Adw.ActionRow(title="Performance mode")
        self.mode = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        for name, label in MODES:
            self.mode.add(Adw.Toggle(name=name, label=label))
        self.mode.connect("notify::active-name",
                          lambda t, _p: None if self.syncing else self.set_mode(t.get_active_name()))
        self.mode_row.add_suffix(self.mode)
        ctl.add(self.mode_row)
        self.fan_row = Adw.ActionRow(title="Fan", subtitle="Full speed overrides the firmware fan table")
        self.fan = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        for name, label in (("auto", "Auto"), ("full", "Full speed")):
            self.fan.add(Adw.Toggle(name=name, label=label))
        self.fan.connect("notify::active-name",
                         lambda t, _p: None if self.syncing else self.run("fan", t.get_active_name()))
        self.fan_row.add_suffix(self.fan)
        ctl.add(self.fan_row)
        page.add(ctl)

        self.sync_controls()
        self.refresh()
        GLib.timeout_add_seconds(1, self.refresh)

    # -- helpers -----------------------------------------------------------
    def set_toggle(self, tg, name):
        self.syncing = True
        tg.set_active_name(name)
        self.syncing = False

    def name_has_owner(self, name):
        try:
            r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "NameHasOwner",
                                   GLib.Variant("(s)", (name,)), None, 0, 200, None)
            return r.unpack()[0]
        except GLib.Error:
            return False

    def set_mode(self, mode):
        """Prefer power-profiles-daemon so GNOME's power mode stays in sync."""
        if self.name_has_owner(PPD[0]):
            try:
                self.bus.call_sync(PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Set",
                                   GLib.Variant("(ssv)", (PPD[0], "ActiveProfile",
                                                          GLib.Variant("s", PPD_MAP[mode]))),
                                   None, 0, 2000, None)
                GLib.timeout_add(500, lambda: (self.sync_controls(), False)[1])
                return
            except GLib.Error as e:
                self.toasts.add_toast(Adw.Toast(title=f"power-profiles-daemon: {e.message}"))
        self.run("profile", mode)

    def run(self, *args):
        proc = Gio.Subprocess.new(
            ["pkexec", HELPER, *args],
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)

        def done(p, res):
            _ok, out, _ = p.communicate_utf8_finish(res)
            if p.get_exit_status() != 0:
                msg = (out or "").strip().splitlines()
                self.toasts.add_toast(Adw.Toast(
                    title=f"Couldn't change {args[0]}: {msg[-1] if msg else 'not authorized'}"))
            self.sync_controls()
            self.refresh()

        proc.communicate_utf8_async(None, None, done)

    def sync_controls(self):
        mode = read(PROFILE, "balanced")
        self.set_toggle(self.mode, mode)
        self.mode_row.set_subtitle(MODE_INFO.get(mode, ""))
        full = self.asus and read(f"{self.asus}/pwm1_enable") == "0"
        self.set_toggle(self.fan, "full" if full else "auto")

    def chip(self, name, text, on=None):
        c = self.chips[name]
        c.set_label(text)
        if on is not None:
            c.set_css_classes(["chip", "on"] if on else ["chip"])

    def refresh(self):
        temp = int(read(f"{self.coretemp}/temp1_input", "0")) / 1000 if self.coretemp else None
        rpm = int(read(f"{self.asus}/fan1_input", "0")) if self.asus else None
        if rpm and rpm > self.fan_max:
            self.fan_max = int(math.ceil(rpm * 1.15 / 500) * 500)
            self.history.fan_max = self.fan_max
        freqs = [int(read(p, "0")) / 1e6
                 for p in glob.glob(f"{CPU}/cpu[0-9]*/cpufreq/scaling_cur_freq")]
        freq = max(freqs) if freqs else None
        state = read_json(STATE, {})
        watts = state.get("power")
        pl1 = int(read(f"{MMIO}/constraint_0_power_limit_uw", "0")) // 1000000
        pl2 = int(read(f"{MMIO}/constraint_1_power_limit_uw", "0")) // 1000000

        self.g_temp.set_value(temp)
        self.g_fan.set_value(rpm, self.fan_max)
        self.g_freq.set_value(freq)
        self.g_watts.set_value(watts, max(pl2, 1))
        self.history.watt_max = max(pl2, 1)
        self.history.push(temp, rpm, freq, watts)

        on_ac = read("/sys/class/power_supply/AC0/online") == "1"
        self.chip("power", "⚡ Plugged in" if on_ac
                  else f"🔋 {read('/sys/class/power_supply/BAT0/capacity')}%")
        turbo = read(f"{CPU}/intel_pstate/no_turbo") != "1"
        self.chip("turbo", f"Turbo {'on' if turbo else 'off'}", turbo)
        self.chip("gov", f"{read(f'{CPU}/cpufreq/policy0/scaling_governor').capitalize()} · EPP "
                         f"{read(f'{CPU}/cpufreq/policy0/energy_performance_preference').replace('_', ' ')}")
        self.chip("limits", f"PL1 {pl1} W · PL2 {pl2} W")
        tgt, pol, skin = state.get("target"), state.get("policy", {}), state.get("skin")
        if tgt:
            self.chip("target", f"DTT {tgt.replace('_', ' ')} · PL1 {pol.get('pl1_min')}–{pol.get('pl1_max')} W"
                                + (f" · skin {skin:.0f} °C" if skin is not None else ""), True)
        else:
            self.chip("target", "State daemon not running", False)
        thermald = self.name_has_owner("org.freedesktop.thermald")
        self.chip("engine", "Policy: thermald (ASUS DTT)" if thermald else "Policy: none — firmware defaults",
                  thermald)
        self.chips["throttle"].set_visible(bool(state.get("throttled")))
        if not self.syncing:
            self.sync_controls()
        return True


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="local.PerfControl")

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
