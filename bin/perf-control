FAN_COLOR = (0.21, 0.52, 0.89)
FREQ_COLOR = (0.57, 0.33, 0.80)
POWER_COLOR = (0.18, 0.66, 0.45)
LOW_COLOR = (0.88, 0.27, 0.22)

